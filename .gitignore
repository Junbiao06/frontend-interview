# ============================================================
# Obsidian vault - Git 远程同步
# ============================================================

# macOS / Windows 系统文件
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# Obsidian：每台设备独立的界面布局与临时状态
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# Obsidian 回收站（不参与同步）
.trash/

# 编辑器临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# 常见同步工具产生的冲突副本
*.sync-conflict-*
*.syncthing-conflict-*

# 日志文件
*.log
